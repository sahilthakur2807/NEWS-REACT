NEWS_API_KEY=
# Neon/Postgres connection URL (recommended for Vercel)
POSTGRES_URL=
# Optional individual connection fields (alternative to POSTGRES_URL)
# PGHOST=
# PGUSER=
# PGDATABASE=
# PGPASSWORD=
# PGPORT=5432
# PGSSL=true

# Frontend (Vite) Firebase client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend (Vercel serverless) Firebase Admin credentials
# Use ONE of the following approaches:
FIREBASE_SERVICE_ACCOUNT_JSON=
# OR:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional
# VITE_API_BASE_URL=          # leave empty on Vercel
# VITE_ENABLE_REALTIME_CHAT=false
# VITE_CHAT_SOCKET_URL=